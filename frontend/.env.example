# --- KMES School frontend build-time configuration ---
# Copy to `.env` (or set via the build platform) for the environment you are
# building for. This value is baked into the built SPA at build time.

# Development: local backend
VITE_API_BASE_URL=http://localhost:5000

# Staging: set by the staging build to the staging API (e.g.)
#   VITE_API_BASE_URL=https://staging-api.schooldomain.com
# Production: set by the production build to the production API (e.g.)
#   VITE_API_BASE_URL=https://api.schooldomain.com

# SECURITY: Only public, non-secret values may appear in VITE_* variables. They
# are embedded into browser-visible static assets. Never put a JWT_SECRET,
# database URI, Cloudinary/API key, Facebook token, or any credential here.