# --- KMES School backend configuration ---
# Copy this file to `.env` and fill in real values for your environment.

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kmes
JWT_SECRET=replace-with-a-long-random-string
# Frontend origin allowed by CORS (and the trust alias for CLIENT_URL).
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Cloudinary (media uploads; leave blank to disable Cloudinary storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Phase 9: Facebook integration (optional; leave blank to disable) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Phase 10: AI content assistant (optional; leave blank to disable AI) ---
AI_PROVIDER=            # e.g. openai | anthropic | gemini
AI_API_KEY=             # your provider API key (server-only, never sent to browser)
AI_MODEL=               # e.g. gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash

# --- Development-only: seeded administrator (ignored when NODE_ENV !== development) ---
DEV_ADMIN_EMAIL=dev.admin@local.test
DEV_ADMIN_PASSWORD=replace-with-a-strong-local-password

# --- Phase 18B: password-reset email delivery ---
# EMAIL_PROVIDER=mock   -> in-memory mock (never sends a real email; safe default)
# EMAIL_PROVIDER=none   -> safe no-op (no real provider configured yet)
# A future production value (e.g. smtp | resend) may be added later.
# No real SMTP credentials are required in this phase.
EMAIL_PROVIDER=mock
# Optional public base used to build the reset link delivered to the user.
# Leave as the FRONTEND_URL above; no tokens are stored or logged.
RESET_LINK_BASE=
