# --- KMES School backend configuration ---
# Copy this file to `.env` and fill in real values for your environment.
#
# Each environment (development / staging / production) MUST have its own `.env`/
# secret store with its OWN values. NEVER share JWT_SECRET, MONGODB_URI, or any
# integration credential between environments. No real secret values are tracked
# in this repository — placeholders only.
#
# For the full deployment guide see docs/DEPLOYMENT.md.

NODE_ENV=development            # development | staging | production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/kmes
JWT_SECRET=replace-with-a-long-random-string

# --- CORS ---
# Explicit comma-separated allow-list of frontend origins this backend may serve.
# NO wildcard "*" is ever allowed. Development/Staging/Production each set only
# their own origin(s).
#   dev:      http://localhost:5173
#   staging:  https://kmes-school-lzs3g1qdw-saugatb40-8093.vercel.app (current Vercel staging)
#             (comma-join other staging aliases you explicitly allow, e.g. https://kmes-school.vercel.app)
#   prod:     https://www.schooldomain.com
ALLOWED_ORIGINS=http://localhost:5173
# Back-compat aliases (optional). FRONTEND_URL is also the reset-link fallback base.
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Reverse proxy / PaaS edge ---
# Set to the number of trusted reverse-proxy hops on the production PaaS (see
# docs/DEPLOYMENT.md). Keep 0 locally so rate limiting uses the client IP
# directly. Do NOT set "true" blindly.
TRUST_PROXY=0

# --- Password-reset link base (Phase 18C-3) ---
# The SINGLE source used to build password-reset links. Env-specific so staging
# links can never point at production (and vice-versa).
#   dev:      http://localhost:5173
#   staging:  https://staging.schooldomain.com
#   prod:     https://www.schooldomain.com
RESET_LINK_BASE=http://localhost:5173

# --- Cloudinary (media uploads; leave blank to disable Cloudinary storage) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Phase 9: Facebook integration (optional; leave blank to disable) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Phase 10: AI content assistant (optional; leave blank to disable AI) ---
AI_PROVIDER=            # e.g. openai | anthropic | gemini
AI_API_KEY=             # your provider API key (server-only, never sent to browser)
AI_MODEL=               # e.g. gpt-4o-mini, claude-3-5-sonnet, gemini-1.5-flash

# --- Development-only: seeded administrator (ignored when NODE_ENV !== development) ---
DEV_ADMIN_EMAIL=dev.admin@local.test
DEV_ADMIN_PASSWORD=replace-with-a-strong-local-password

# --- Phase 18B/18C-4/20: password-reset email delivery ---
# EMAIL_PROVIDER=mock   -> in-memory mock (never sends a real email; safe default)
# EMAIL_PROVIDER=none   -> safe no-op (no real provider configured yet)
# EMAIL_PROVIDER=smtp   -> REAL production delivery via Nodemailer (Phase 18C-4).
#                          REQUIRES SMTP_HOST + SMTP_USER + SMTP_PASSWORD. Any
#                          OTHER value causes startup to fail (no silent fallback).
EMAIL_PROVIDER=mock
# --- SMTP provider (only read when EMAIL_PROVIDER=smtp; never commit real creds) ---
SMTP_HOST=                # e.g. smtp.sendgrid.net, smtp.postmarkapp.com, smtp.gmail.com
SMTP_PORT=587             # 465 implies implicit TLS; 587 uses STARTTLS
SMTP_SECURE=false         # true -> implicit TLS; false -> STARTTLS (default)
SMTP_USER=                # SMTP username (auth user) — required for smtp
SMTP_PASSWORD=            # SMTP password / API token (auth pass) — required for smtp
# SMTP_PASS=              # (optional back-compat alias for SMTP_PASSWORD)
EMAIL_FROM=               # sender address; falls back to SMTP_USER
EMAIL_FROM_NAME=Kaseni Model Secondary English School
# The reset-link URL base is configured ABOVE via RESET_LINK_BASE (env-specific).
# No raw tokens are stored or logged.

# --- Phase 20: first-admin bootstrap (STRICTLY disabled by default) ---
# Only the literal value "true" enables bootstrap ("1", "yes", "TRUE" all = off).
# While it is enabled AND the database has zero users, ONLY the email in
# ADMIN_BOOTSTRAP_EMAIL may create the first (admin) account via /api/auth/register.
# After the first user exists, public registration is closed forever even if the
# flag stays true. Keep disabled in production unless actively provisioning.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_BOOTSTRAP_EMAIL=saugatb40@gmail.com

# Vercel preview deployments (kmes-school-<hash>-<team>.vercel.app) are allowed by CORS
# by default. Once every real frontend origin is listed in ALLOWED_ORIGINS, set to false.
ALLOW_VERCEL_PREVIEWS=true
